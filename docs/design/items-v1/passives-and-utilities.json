{
  "schema_version": "1.0",
  "design_date": "2026-10-13",
  "requirement_event": "EV-021",
  "module": "D-03",
  "status": "design_only",
  "parameter_status": "proposed_untested",
  "scope": "原创助手方案。局内被动遗物与功能工具；不是局外遗物碎片。未制作、未逐项获用户确认。",
  "global_rules": {
    "relic_slots": 3,
    "one_active_copy_per_id": true,
    "relic_enchantable": false,
    "relic_merge_or_upgrade": false,
    "relic_equip": "仅清房后的安全地面站定E交互0.50s；提交前移动、受伤或合法闪避取消，保留旧归属与地面物。战斗和暂停面板内不能换。",
    "stat_aggregation": "当前武器、身体甲的附魔、有效遗物及临时增益先在同stat相加，再按装备v2同一最终上限计算；不另乘一层。备用武器和背包/地面遗物不贡献。",
    "stat_change_no_resource_gain": "装卸不治疗、不回专注、不补弹、不刷新闪避/技能/附魔/遗物触发冷却；HP上限变化仅current=min(old,newMax)，累计削韧和破韧保护保留。",
    "relic_trigger_memory": "角色本局以relicID保存CD截止和各RoomID预算，装卸、换武器、重新进房不清零；本局模拟时钟推进，暂停冻结。",
    "keyring": "功能工具独立随身栏，不占三遗物槽或快捷槽；各ID按stack_max封顶，不自动卖出/转钱/转收集物。",
    "utility_transaction": "安全地面匹配设施：展示工具、原服务、结果/风险和剩余费用，确认后同一事务扣一次工具并提交一次服务。任何校验失败保留工具和原对象；事务去重、随机结果和同局继续遵循D-01。",
    "utility_nonstacking": "同一次服务最多用一件本目录功能工具，不与同类券叠用，不通过退出重抽或退款反复领取。",
    "utility_source_gate": "按当局已解锁且确有可匹配对象的来源过滤；D-07/08若不采用该设施/工序则不投放对应工具。没有匹配对象时不占稀缺奖励格。",
    "meta_unlock": "仅使此ID有资格加入来源池；不保证出现，不每局赠送，不代表D-09解锁费用/树已完成。",
    "pricing_status": "本目录无商店售价、出售与转换；D-08再核定来源权重/价值/金币经济。",
    "runtime_implemented": false
  },
