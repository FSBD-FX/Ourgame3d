          "amount_per_tick": 8,
          "duration_s": 5,
          "tick_interval_s": 1,
          "ticks": 5,
          "first_tick_delay_s": 1,
          "target": "self",
          "group": "regen_hp",
          "timing": "start_at_commit",
          "healing_received": "current_at_each_tick",
          "stacking": "reject_if_regen_hp_active",
          "overheal": "discard",
