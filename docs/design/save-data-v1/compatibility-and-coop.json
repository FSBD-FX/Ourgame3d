  "coop_questions": [
    {
      "id": "COOP-Q01",
      "topic": "人数与参与方式",
      "question": "合作支持多少人，是否本地同屏、线上或两者？",
      "not_decided": true,
      "solo_guard": "当前只有1名本地玩家。",
      "cost": "人数改变镜头可读性、房间面积、出生/敌人容量、装备界面和测试组合。"
    },
    {
      "id": "COOP-Q02",
      "topic": "权威与拓扑",
      "question": "由哪一层权威判定战斗、经济和保存，是否允许权威转移？",
      "not_decided": true,
      "solo_guard": "当前单一本地权威。",
      "cost": "连接/托管、运行维护、延迟与故障恢复成本随方案变化；未选择网络框架或平台。"
    },
    {
      "id": "COOP-Q03",
      "topic": "同屏镜头与分散",
      "question": "玩家分散、跨纵深或一人靠近出口时镜头和可达边界如何处理？",
      "not_decided": true,
      "solo_guard": "D12镜头与D07出生约束按单人复验。",
      "cost": "镜头/场地重做、提示可读性与多人走位测试，不能只放大视野。"
    },
    {
      "id": "COOP-Q04",
      "topic": "局内钱与设施",
      "question": "金币与优惠券归谁，能否共享/转让，设施扣款的授权范围是什么？",
      "not_decided": true,
      "solo_guard": "现有Run钱包与唯一消耗不变。",
      "cost": "跨玩家收支、竞争购买、取消与重复请求事务矩阵。"
    },
    {
      "id": "COOP-Q05",
      "topic": "拾取与装备归属",
      "question": "掉落为公共抢拾、专属、分配还是投票；可否交易/赠送？",
      "not_decided": true,
      "solo_guard": "D04每实例仅一个合法持有者，拾取一次。",
      "cost": "所有权争用、背包容量、地面掉落和跨玩家转移原子性；不会默认复制奖励。"
    },
    {
      "id": "COOP-Q06",
      "topic": "永久成长与客人",
      "question": "各Profile天赋/研究怎样入局，客人是否保留碎片、样品与研究？",
      "not_decided": true,
      "solo_guard": "D09冻结单Profile快照及未结束锁保持。",
      "cost": "跨账号授权与提交、离线账号、退款价格凭据及差异平衡。"
    },
    {
      "id": "COOP-Q07",
      "topic": "死亡与失败",
      "question": "是否倒地/复活，一人死亡能否继续，何时本局结束？",
      "not_decided": true,
      "solo_guard": "沿用当前玩家死亡、Boss同点伤害后存活要求。",
      "cost": "新增死亡状态机、奖励资格和残局/退出测试；不能预设复活机制。"
    },
    {
      "id": "COOP-Q08",
      "topic": "暂停与焦点",
      "question": "菜单、失焦、控制器断开和剧情阅读能否暂停整个合作局？",
      "not_decided": true,
      "solo_guard": "D11单人暂停完整冻结，不推导投票或线上不停。",
      "cost": "多时钟、输入消费和危险中菜单交互重设计。"
    },
    {
      "id": "COOP-Q09",
      "topic": "退出与跨房",
      "question": "谁能选路/付门票/确认丢弃物与跨关，其他玩家在攻击或DoT中如何处理？",
      "not_decided": true,
      "solo_guard": "D04普通免费出口与付费完整安全条件不改。",
      "cost": "跨玩家一致提交、边界/迟到请求和房间资源清理。"
    },
    {
      "id": "COOP-Q10",
      "topic": "中途加入与离开",
      "question": "是否允许后加入、退出、重连，加入者出现位置和已有结果如何确定？",
      "not_decided": true,
      "solo_guard": "本地精确续局不自动成为联机快照。",
      "cost": "快照授权、内容版本一致性、断线库存与重放/抢领风险测试。"
    },
    {
      "id": "COOP-Q11",
      "topic": "保存与恢复",
      "question": "谁持有合作局，离线客人能否继续，恢复是否要求所有人同代？",
      "not_decided": true,
      "solo_guard": "单Profile整bundle A/B设计保持。",
      "cost": "跨账号保存协议、冲突恢复和权威丢失处理；不能默认为共享存档。"
    },
    {
      "id": "COOP-Q12",
      "topic": "命中与延迟",
      "question": "是否友伤/身体阻挡，远端输入迟到时怎样保证真实命中与预告？",
      "not_decided": true,
      "solo_guard": "D02/D05/D06当前命中和友军挡弹规则不变。",
      "cost": "动作时序、预测/回滚候选比较及高延迟可读性验收；未选技术。"
    },
    {
      "id": "COOP-Q13",
      "topic": "奖励与故事资格",
      "question": "Boss成功、首奖、发现与结局分别按玩家还是队伍判定？",
      "not_decided": true,
      "solo_guard": "D10账号事实/Run成功/已读分离；奖励唯一事件保持。",
      "cost": "掉线/死亡/晚加入的参与资格和账号事实跨域事务。"
    },
    {
      "id": "COOP-Q14",
      "topic": "难度与内容预算",
      "question": "是否随人数缩放HP/敌数/掉落，房间容量与资源怎样重新预算？",
      "not_decided": true,
      "solo_guard": "不自动翻倍收益/敌人，也不预设倍率。",
      "cost": "D05-D08重平衡、武器/状态组合与设备性能测试。"
    },
    {
      "id": "COOP-Q15",
      "topic": "商业平台与权限",
      "question": "目标平台、帐号、邀请/匹配、跨平台、地区与隐私范围是什么？",
      "not_decided": true,
      "solo_guard": "ProfileID不等于平台账号，当前无商业平台承诺。",
      "cost": "平台接入/审批、用户数据、在线服务费用与运营支持；具体费用无真实报价。"
    },
    {
      "id": "COOP-Q16",
      "topic": "验收与发布范围",
      "question": "合作是否独立里程碑，目标设备、体验指标和维护投入怎样接受？",
      "not_decided": true,
      "solo_guard": "先验证单人存档与D14整局，不把接口预留记完成。",
      "cost": "多人组合、长局存档、异常注入、兼容版本与后续维护工时需单独排期估算。"
    }
  ],
