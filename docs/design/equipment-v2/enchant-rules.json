    "required_instance_fields": ["content_id", "instance_id", "instance_version", "enchant_package", "enchant_tier", "affix_ids", "magnitudes", "original_quantile_rationals", "generation_seed", "algorithm_version", "affix_catalog_version", "attribute_rules_version", "weapon_skill_cooldown_deadline"],
