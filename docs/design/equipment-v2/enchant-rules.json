    "element_attempts_per_attack_id": 1,
    "element_target": "first_legal_enemy_with_positive_direct_hp_damage",
    "element_attempt_opportunity_consumed_at_first_target": true,
    "first_target_killed_by_direct_hit": "consume_attack_opportunity_and_ready_role_cooldown_no_corpse_status_no_target_reselection",
    "element_role_cooldown_not_ready_behavior": "no_effect_no_attempt_on_later_targets",
    "element_role_cooldown_ready_behavior": "consume_role_cooldown_then_attempt_effect",
    "element_rejected_by_stronger_status_target_cooldown_or_poise_protection": "no_role_cooldown_refund_no_target_reselection",
    "intrinsic_skill_effects_grant_extra_enchant_attempts": false
