    "polarity_text_and_symbols_required": true,
    "color_only_meaning_allowed": false,
    "negative_affixes_may_be_hidden": false,
    "show_effective_interval_when_base_clips_range": true,
    "show_inactive_weapon_state": true,
    "random_operations_show_probability_and_fixed_price_only_before_confirm": true,
    "reroll_warning": "保等级，整套重抽，可出现纯负面，确认后立即生效",
    "failure_reason_text_required": true
