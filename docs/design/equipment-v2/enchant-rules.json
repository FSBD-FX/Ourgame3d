{
  "schema_version": "2.0",
  "status": "design_only",
  "design_date": "2026-10-12",
  "authority": "original_proposal_not_reference_game_specification",
  "base_equipment_version": "equipment-v1",
  "equipment_count": {"weapons": 33, "armor": 12, "total": 45},
  "enchantable": {"all_existing_equipment": true, "future_default": true, "max_tier": 5},
  "tiers": [
    {"tier": 1, "label": "I"},
    {"tier": 2, "label": "II"},
    {"tier": 3, "label": "III"},
    {"tier": 4, "label": "IV"},
    {"tier": 5, "label": "V"}
  ],
  "slot_rule": {
    "slots_per_instance": 1,
    "slot_contains": "one_package_with_one_shared_tier",
    "none_has_tier": false,
    "preserve_content_id_and_intrinsic_traits": true,
    "does_not_define_item_rarity": true,
    "negative_affixes_bind_equipment": false,
    "discard_or_replace_allowed": true
  },
  "spawn_enchant_chance": 0.4,
  "spawn_none_chance": 0.6,
  "package_weights": {"beneficial": 0.6, "mixed": 0.3, "cursed": 0.1},
  "package_weights_are_conditional_on_enchanted": true,
  "unconditional_spawn_probabilities": {"none": 0.6, "beneficial": 0.24, "mixed": 0.12, "cursed": 0.04},
  "packages": {
    "beneficial": {"positive_affixes": 1, "negative_affixes": 0},
    "mixed": {"positive_affixes": 2, "negative_affixes": 1},
    "cursed": {"positive_affixes": 0, "negative_affixes": 1}
  },
  "tier_pools": {
    "early": {"1": 0.7, "2": 0.25, "3": 0.05, "4": 0.0, "5": 0.0},
    "middle": {"1": 0.15, "2": 0.4, "3": 0.35, "4": 0.1, "5": 0.0},
    "advanced": {"1": 0.0, "2": 0.1, "3": 0.4, "4": 0.35, "5": 0.15}
  },
  "sign_rule": {
    "magnitude_is_positive_integer": true,
    "signed_value_formula": "magnitude * direction",
    "direction_values": [-1, 1],
    "polarity_values": ["beneficial", "harmful"],
    "polarity_is_not_numeric_sign": true,
    "examples": [
      {"stat": "skill_cooldown_pct", "polarity": "beneficial", "direction": -1, "meaning": "武器技冷却降低"},
      {"stat": "focus_cost_pct", "polarity": "beneficial", "direction": -1, "meaning": "专注消耗降低"},
      {"stat": "physical_vulnerability_pct", "polarity": "harmful", "direction": 1, "meaning": "物理易伤增加"}
    ],
    "percent_storage": "percentage_points_as_integer_12_means_12_percent"
  },
  "exclusivity": {
    "duplicate_affix_ids_allowed": false,
    "max_affixes_per_group": 1,
    "opposite_affixes_share_group": true,
    "element_group": "elemental",
    "element_members": ["burn_dps", "slow_pct", "shock_flat"],
    "mixed_positive_affixes_are_unordered": true,
    "stored_affixes_order": "stable_id_sort"
  },
  "eligibility": {
    "weapon_and_armor_pools_separate": true,
    "move_speed_available_to": ["weapon", "armor"],
    "reload_families": ["XBW", "PST", "SGN", "RFL"],
    "focus_cost_families": ["STF"],
    "reach_excluded_families": ["SGN"],
    "filter_before_random_sampling": true,
    "negative_armor_and_ward_max": "item_intrinsic_base_value",
    "negative_poise_max": "item_intrinsic_poise_bonus_not_character_base_30",
    "effective_interval": "intersection(tier_closed_integer_interval, item_nonzero_legal_interval)",
    "empty_interval_behavior": "exclude_candidate",
    "no_effect_candidates_allowed": false,
    "temporary_other_equipment_caps_change_candidate_pool": false,
    "global_caps_still_apply_after_combination": true,
    "insufficient_package_combinations_behavior": "reject_configuration_or_operation_before_payment_without_silent_fallback",
    "description": "每个词条仍须通过目录eligible_kinds、eligible_weapon_families与排除条件；类型可用不等于每级数值都有合法区间。"
  },
  "generation": {
    "order": ["validate_definition_and_source", "roll_enchanted", "roll_package", "roll_shared_tier", "enumerate_eligible_complete_combinations", "sample_one_complete_combination", "sample_each_integer_magnitude_and_store_original_q", "commit_instance_once"],
    "combination_sampling": "uniform_over_eligible_complete_combinations_without_permutation_duplicates",
    "magnitude_sampling": "uniform_integer_in_effective_closed_interval_using_rejection_sampling",
    "algorithm_version": "integer_uniform_center_quantile_v1",
    "quantile": {
      "meaning": "original_sampled_integer_bucket_midpoint",
      "numerator_formula": "2 * (magnitude - min) + 1",
      "denominator_formula": "2 * (max - min + 1)",
      "storage": "positive_integer_numerator_and_denominator",
      "range": "0 < q < 1",
      "upgrade_formula": "new_min + floor(q_numerator * (new_max - new_min + 1) / q_denominator)",
      "preserve_original_across_all_upgrades": true,
      "fixed_interval_quantile": {"numerator": 1, "denominator": 2}
    },
    "persistent_seed_and_rng_cursor": true,
    "spawn_on_visibility_or_pickup": false,
    "stable_spawn_event_id": true,
    "duplicate_spawn_event_returns_existing_instance": true,
    "invalid_source_reward_behavior": "retain_pending_reward_and_report_configuration_error_no_silent_reroll"
  },
  "operations": {
    "awaken": {
      "name": "觉醒",
      "requires_package": "none",
      "cost_gold": 20,
      "result_tier": 1,
      "random_package_weights_ref": "package_weights",
      "can_produce_negative": true
    },
    "reroll": {
      "name": "重洗",
      "allowed_tiers": [1, 2, 3, 4, 5],
      "cost_gold_by_tier": {"1": 15, "2": 30, "3": 55, "4": 85, "5": 120},
      "preserve_tier": true,
      "reroll_fields": ["package_type", "affix_ids", "magnitudes", "original_quantiles"],
      "random_package_weights_ref": "package_weights",
      "preview_random_result_before_commit": false,
      "can_get_worse": true
    },
    "upgrade": {
      "name": "升阶",
      "allowed_from_tiers": [1, 2, 3, 4],
      "cost_gold_by_from_tier": {"1": 40, "2": 80, "3": 140, "4": 220},
      "tier_delta": 1,
      "preserve_fields": ["package_type", "affix_ids", "original_quantiles"],
      "negative_affixes_upgrade_too": true,
      "prevalidate_all_next_tier_intervals": true,
      "empty_next_interval_behavior": "reject_before_payment_with_reason_no_affix_substitution_or_clamping",
      "deterministic_result_comparison_allowed": true
    },
    "cleanse": {
      "name": "洗净",
      "allowed_tiers": [1, 2, 3, 4, 5],
      "cost_gold_by_tier": {"1": 10, "2": 20, "3": 35, "4": 55, "5": 80},
      "result_package": "none",
      "remove_entire_package": true,
      "remove_tier_and_affix_quantiles": true,
      "preserve_intrinsic_traits": true,
      "selective_negative_removal": false
    }
  },
  "workshop": {
    "requires_room_cleared": true,
    "requires_player_alive_grounded_idle": true,
    "blocked_states": ["combat", "attacking", "hurt", "reloading", "jumping", "switching_weapon", "changing_armor"],
    "target_scope": "owned_weapon_slot_1_or_2_or_body_armor",
    "ground_items_directly_mutable": false,
    "inactive_weapon_affixes_apply": false,
    "transaction_locks_target_ownership": true,
    "refill_hp": false,
    "refill_focus": false,
    "refill_magazine": false,
    "reset_any_cooldown": false,
    "reset_existing_enemy_status": false,
    "max_health_recalculation": "current_hp_only_clamped_down_no_heal_on_increase",
    "affix_locking_or_transfer": false,
    "extra_material_costs": false,
    "pity_system": false
  },
  "effect_resolution": {
    "attack_snapshot_at": "windup_40_percent_lock_point",
    "lifesteal_rate_uses_attack_snapshot": true,
    "healing_received_uses_current_recipient_stats_at_restore_time": true,
    "all_healing_requires_living_recipient": true,
