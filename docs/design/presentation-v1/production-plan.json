  "coordinate_export_contract": {
    "image_px": "untrimmed logical canvas; origin top_left; +u right; +v down; pixel-edge continuous coordinates",
    "rig_local": "origin at owned main pivot; +u right; +v up; unit cm; actual source_pixels_per_cm recorded in asset manifest",
    "pivot_ownership": "actor_and_armor_layers use ground_root; independent weapons use grip_primary; emitters use parent-local transform; no foot markers required on standalone weapons",
    "local_to_untrimmed_px": "u=pivot_x+local_u*scale; v=pivot_y-local_v*scale",
    "untrimmed_to_trimmed_px": "trimmed_u=u-trim_offset_x; trimmed_v=v-trim_offset_y; preserve logical canvas and original pivot",
    "left_facing": "mirror rig_local_u about owned pivot before pixel conversion; do not mirror pivot again; explicit left-art/rig variants override naive reflection and must provide complete matching marker table",
    "parent_transform": "child grip local transformed to parent hand socket once, then root world X/Y/Z and shared viewport projection; image-pixel v is never world ground Y",
    "source_dimensions": "512 or1024 are proposed canvases not collision dimensions; source pixel/cm measured and recorded at asset intake"
  }
