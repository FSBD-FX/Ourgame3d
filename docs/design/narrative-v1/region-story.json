  "factions": [
    {
      "id": "FACTION-STONE",
      "name": "石卫署",
      "families": [
        "STN"
      ],
      "kind": "旧公共防务机构及其战体",
      "former_public_role": "灾时核验出入、护送城民与守住危险边界。",
      "present_position": "离城限制未被注销，仍把核销役额当放行前提；公开使命与现行军令已经背离。",
      "internal_difference": "多数石壳只执行碑令，旧刻痕仍留着送行职责；不能因此说城中所有守卫都自愿支持永久拘留。"
    },
    {
      "id": "FACTION-ROOT",
      "name": "林庭共同体",
      "families": [
        "ELF",
        "TRE"
      ],
      "kind": "森林居民、盟约守林者与根脉生灵的不同立场集合",
      "former_public_role": "灾时允许借根脉供城，约定灾后返还。",
      "present_position": "守旧盟条、担心停供后的灾害、保护受损根井和要求返还者并存。",
      "internal_difference": "精灵有能自主选择的盟约立场，树人多因根脉受损保护领地；同在林庭不等于认同同一政策。"
    },
    {
      "id": "FACTION-RITE",
      "name": "灰烛司仪会",
      "families": [
        "ROB",
        "SKL"
      ],
      "kind": "掌名册与祭仪的组织及被它征役的骨身",
      "former_public_role": "登记灾时失踪、祭奠死者，并以有限役额维持公共工作。",
      "present_position": "名册不断把姓名折成可续役额，制度维护者将“城仍运作”当作正当理由。",
      "internal_difference": "穿法袍是职务而非种族；有主动维护制度者和离开组织的人。骨身是承受役额的对象，不与管理者承担同等责任。"
    },
    {
      "id": "FACTION-WORK",
      "name": "续签工造局",
      "families": [
        "MEC"
      ],
      "kind": "工造设备、使者系统与决定续签的管理体系",
      "former_public_role": "灾时运料、修门、供热和救急劳动。",
      "present_position": "灾后仍有签署者主动维持征用；有获利、保饭食、怕停炉等不同动机，不能全部归咎失控机器。",
      "internal_difference": "机械使者执行工单，重锤设备执行关口任务；主动签字者与被迫劳动者不能混成一个“机械种族”。"
    },
    {
      "id": "FACTION-MARGINS",
      "name": "城隙行会与游群",
      "families": [
        "GOB",
        "BST"
      ],
      "kind": "叙事归类而非统一军政阵营",
      "former_public_role": "城缝中的交易、搬运与野外生态各自存在。",
      "present_position": "哥布林交易团在禁出制度下互助或逐利；野兽因采根、运输与筑墙失去栖地而守穴。",
      "internal_difference": "交易团与兽群没有共同统帅或共同政治目标；芬砾是哥布林友善贸易的既有反例，不能把敌对分支当全族天性。"
    },
    {
      "id": "FACTION-EMBER",
      "name": "烬誓廷",
      "families": [
        "DEM"
      ],
      "kind": "领主及信奉永留誓词的护廷力量",
      "former_public_role": "以共同留守抵抗灾难，誓约曾承载真实保护。",
      "present_position": "把怕城散、怕失去秩序的恐惧变成强留他人的权力，仍有自愿认同者。",
      "internal_difference": "恶魔战斗单位是烬相/誓卫等敌对分支，不把所有相同外形生命判作天生恶；主线针对强制誓约。"
    }
  ],
  "enemy_family_story": [
    {
      "family": "STN",
      "faction_id": "FACTION-STONE",
      "origin": "由灾时公共石工造出的骑士、哨像和巡空石蝠；军令碑把出入核验写进战体。",
      "motivation": [
        "按未注销的碑令阻止役额离城",
        "守住昔日护送城民的责任但失去期限判断"
      ],
      "contract_relationship": "军令执行型；不等于每块石头像活人一样自愿选择独裁。",
      "distinction": "敌方石卫的核心反转是拦离城者；石壳持久而程序迟滞，与野兽本能、哥布林逐利不同。",
      "battle_scope_boundary": "石骑锁线冲锋、石蝠近触唤醒及低位恢复均沿D05；本稿不添加离城追杀AI或新机关攻击。",
      "not_whole_kind_evil": "石刻送行纹样和旧护送名目保留原公共使命；战斗单位不代表全体石工或守卫。",
      "mainline_evidence_region": "REG-01"
    },
    {
      "family": "ELF",
      "faction_id": "FACTION-ROOT",
      "origin": "曾与城签短期林契的居民与守林战士，保留自主记忆与判断。",
      "motivation": [
        "有人相信停供会让灾难重来而守旧盟条",
        "有人从守契地位获益",
        "也有人主张按原约返还并离开敌方守关分支"
      ],
      "contract_relationship": "有选择的盟约立场，不是一族同时被法术夺心；是否支持续约须按组织与个人区分。",
      "distinction": "以对盟条的不同解释形成矛盾，与树人的受伤护根不完全相同。",
      "battle_scope_boundary": "弓线、短突刺与锁点施法保持D05，阵营解释不赋予额外逃跑/谈判或召唤技能。",
      "not_whole_kind_evil": "芦苇作为既有友善精灵医师，可在营地回应契约代价；不强迫玩家杀完一族。",
      "mainline_evidence_region": "REG-02"
    },
    {
      "family": "TRE",
      "faction_id": "FACTION-ROOT",
      "origin": "林庭根脉长成的幼株、长臂和树卫，灾时作为供城载体被借用。",
      "motivation": [
        "保护仍被抽取的根井与生长空间",
        "对砍采和逼近本能或有意识地抵抗",
        "部分守关枝体继续承担旧约的防务任务"
      ],
      "contract_relationship": "资源与生命被征用型；母根承受合同，不说明每个树人都理解或认同领主。",
      "distinction": "伤根与领地防卫塑造敌意；击败守关冠枝不等于砍死整片森林唯一生命。",
      "battle_scope_boundary": "既有枝刺、长臂和大型重击不变；新生守关冠枝只解释两次新run之间的重建，不是战斗召唤。",
      "not_whole_kind_evil": "树林可以是居民与生境，敌对树人只是本次防线分支。",
      "mainline_evidence_region": "REG-02"
    },
    {
      "family": "ROB",
      "faction_id": "FACTION-RITE",
      "origin": "灾时登记、护持和祭仪职务的穿袍成员，法袍指职责而非种族。",
      "motivation": [
        "相信名册不断运行才能保住公共秩序",
        "主动维护由续役带来的权力或稳定",
        "用“仍被登记就仍受保护”掩盖抹名后的征用"
      ],
      "contract_relationship": "制度维护与受益型；具有代理选择，不能把所有过错归于遥控。",
      "distinction": "把生命当可续数字的制度语言，与骨身承受的后果形成对照。",
      "battle_scope_boundary": "法刃、咒术与有限护持沿D05，不新增审判抓取或无限复活。",
      "not_whole_kind_evil": "纱柯是已离开旧教团的既有学者，提供可审视制度的立场而非新增职业敌人。",
      "mainline_evidence_region": "REG-03"
    },
    {
      "family": "SKL",
      "faction_id": "FACTION-RITE",
      "origin": "死者遗骨与被名册调用的旧动作残痕构成的役身，不等于完整人格无条件复活。",
      "motivation": [
        "依役额指令维持守盾/巡守等旧任务",
        "残留习惯偶尔与现行命令冲突"
      ],
      "contract_relationship": "死后被征役型；抹去名字使有限责任被改成可重复役额，主要是受害与被利用的一方。",
      "distinction": "骨身承担制度代价，穿袍者管理该制度；两类不能统称同意领主的死灵军团。",
      "battle_scope_boundary": "短刃、骨盾、骨弓规则保持；叙事骨身重组只解释新run间恢复关口，不产生同run复活或额外收益。",
      "not_whole_kind_evil": "死亡者的姓名和关系应被承认，不因敌方骨骸外形否认其曾是城民。",
      "mainline_evidence_region": "REG-03"
    },
    {
      "family": "GOB",
      "faction_id": "FACTION-MARGINS",
      "origin": "长期从事城缝交易、搬运和修补的不同团体，在禁出制度下获得或失去生计。",
      "motivation": [
        "一些团体收路费、出售承诺并从留城债中获利",
        "一些互相借钱、维持公平交换或帮助外来者"
      ],
      "contract_relationship": "间接受益、规避与互助并存；并非全族签过同一种服从契。",
      "distinction": "敌方哥布林体现利用困境的交易选择，不能以族群身份等同贪婪。",
      "battle_scope_boundary": "碎刃、火瓶、铁桶与金牙赌王既有招式不改；故事账目不新增赌局、售卖/回购服务或金额。",
      "not_whole_kind_evil": "既有芬砾商人可与赌王形成对照；主线不要求讨伐整个交易群体。",
      "mainline_evidence_region": "REG-01"
    },
    {
      "family": "MEC",
      "faction_id": "FACTION-WORK",
      "origin": "工造局以灾时图样造出的巡灯、锤卫与旗讯使者，承担真实救急工作后继续被使用。",
      "motivation": [
        "执行工单和稳定压力/运输秩序",
        "使者按续签记录传递指令",
        "背后署名者因获利或生计恐惧选择继续征用"
      ],
      "contract_relationship": "工单执行与人工续签型；战体程序不免除仍在签字的人对制度的责任。",
      "distinction": "资料证明不是单纯失控事故；必须区分主动续签者、劳役者和机械载体。",
      "battle_scope_boundary": "校准弹、蒸锤、行军支援与审判机直轨/泄压均沿旧规则，无新过热伤害/工人增援。",
      "not_whole_kind_evil": "工造技术与洛砧的修造工作本身不邪恶；主线反对强留与无限征役。",
      "mainline_evidence_region": "REG-04"
    },
    {
      "family": "BST",
      "faction_id": "FACTION-MARGINS",
      "origin": "原居林庭和城边的野兽，栖地因采根、道路和围墙缩小。",
      "motivation": [
        "守穴、争夺食物与安全路线",
        "对侵入本次领地的行身作防卫或捕猎反应"
      ],
      "contract_relationship": "没有签约的生态受影响者；不是领主故意遥控的又一支军队。",
      "distinction": "本能、领地和生境压力不同于交易利益与宗教制度；可选探索不自动给玩家道德优越。",
      "battle_scope_boundary": "扑咬、冲撞、双拍与兽王动作沿D05/D06，不添加幼兽护送/驯服系统。",
      "not_whole_kind_evil": "野兽敌对作战行为不代表整片自然都应被清除；未进入可选兽穴不妨碍正常结局。",
      "mainline_evidence_region": "REG-02"
    },
    {
      "family": "DEM",
      "faction_id": "FACTION-EMBER",
      "origin": "灾时余火与长久献誓形成烬相/誓卫等战斗分支，护廷者中仍有认同永留的人。",
      "motivation": [
        "自愿守住他们理解的共同家园",
        "害怕誓约断裂后城与关系散尽",
        "利用护廷地位维持强制秩序"
      ],
      "contract_relationship": "誓词实体化与信念认同型；控制存在但不是解释所有选择的唯一原因。",
      "distinction": "终局冲突是保护与强留的分界，不能简化为恶魔天性或外来魔王侵城。",
      "battle_scope_boundary": "灰镰、持灯、坠印与领主既有地面招式/阶段规则不变，无新增二形Boss或飞行战。",
      "not_whole_kind_evil": "解除的是强制誓约，愿留下的居民及相同外形生命仍可留下；不是抹除一类生命。",
      "mainline_evidence_region": "REG-05"
    }
