  "history": [
    {
      "order": 1,
      "fact": "灾祸迫近，城卫、林庭、祭仪和工造以临时契约维持防卫与供养。"
    },
    {
      "order": 2,
      "fact": "灾祸退去，领主担心城邦解散，不肯执行返还与离城条款。"
    },
    {
      "order": 3,
      "fact": "誓约被持续续签为强制征役；不同群体或得利、或自保、或被困，各有责任。"
    },
    {
      "order": 4,
      "fact": "灯渡营地发现进入封域的方法，执灯客自愿寻找停止强留的源头。"
    },
    {
      "order": 5,
      "fact": "本局五关成功揭开机制，最终击败仍在续写誓约的烬誓领主，让出入成为自由选择。"
    }
  ],
