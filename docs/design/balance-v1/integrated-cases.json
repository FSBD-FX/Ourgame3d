  "conditional_end_to_end_flows": [
    {
      "id": "FLOW-01",
      "name": "零天赋免费主路完整胜利纸面路径",
      "profile": "legal_zero_talent_snapshot_no_research_required; deterministic_starter_SWD001_grade0_unenchanted_gold20_once",
      "route": "35_mainline_checkpoints_in_order; no_optional_purchase_or_branch_required",
      "steps": [
        "commit_new_RunID_and_frozen_snapshot_once",
        "enter_REG01N01; no_start_reward_replay",
        "resolve15_authored_encounters_only_if_player_survives_real_D05_combat; inventory_and_gold_pickup_remain_optional",
        "service_nodes_free_passage_even_at_zero_balance; prep_nodes_no_free_heal",
        "qualified_mainline_Boss_success_M01..M04_commits_existing_awards_and_story_once; legal_chapter_transition_only_once",
        "qualified_final_Boss_success_with_player_alive_commits_M05_world_liberated_and_original_permanent_awards_then_terminal_result",
        "display_already_banked_rewards; active_run_null_only_after_terminal_bundle; hub_mutations_now_allowed",
        "next_RunID_starts_from_first_region_with_new_frozen_snapshot_and_no_old_inventory_gold"
      ],
      "assertions": [
        "no_talent_or_specific_drop_or_paid_entry_is_route_gate",
        "survival_is_not_proved_by_route_connectivity",
        "zero_gold_route_does_not_mean_free_facilities",
        "same_point_double_death_uses_FLOW05_instead"
      ],
      "runtime_tested": false
    },
    {
      "id": "FLOW-02",
      "name": "研究样品已买后第三章死亡",
      "profile": "valid_researched_selected_sample_snapshot; enough_original_gold_at_bound_offer; not_the_zero_research_FLOW01_profile",
      "steps": [
        "same_first_qualifying_N04_offer_binding",
        "commit_cash_cost_item_delivery_sold_stock_and_permanent_sample_purchased_once",
        "commit_M01_M02_and_earned_shards_only_after_actual_success_or_pickup",
        "die_at_REG03N05_after_all_same_time_damage; no_future_rewards_or_postmortem_healing",
        "terminal_bundle_discards_run_gold_equipment_temporary_states_but_keeps_already_banked_shards_M01_M02_and_sample_flag",
        "hub_can_spend_only_actual_balance; same_sample_repurchase_forbidden; new_run_no_previous_item"
      ],
      "assertions": [
        "item_discard_or_death_is_not_sample_refund",
        "unpicked_ground_shards_not_permanent_income",
        "not_a_failure_earnings_rate_or_guaranteed_growth_time"
      ],
      "runtime_tested": false
    },
    {
      "id": "FLOW-03",
      "name": "主动结束与保存退出分开",
      "steps": [
        "pause_run; viewing_hub_does_not_release_active_run",
        "save_and_exit_keeps_same_RunID_and_hub_purchase_lock",
        "explicit_abandon_confirmation_includes_lost_run_gold_inventory_and_unclaimed_loot",
        "commit_one_terminal_abandon_result_preserving_only_previously_earned_permanent_facts_no_new_Boss_or_clear_awards",
        "same_abandon_OperationID_retry_returns_existing_result"
      ],
      "assertions": [
        "menu_navigation_is_not_abandon",
        "no_gold_to_shard_conversion",
        "abandon_not_free_heal_teleport_back_to_same_run"
      ],
      "runtime_tested": false
    },
    {
      "id": "FLOW-04",
      "name": "深入触发未接纳时保存继续",
      "steps": [
        "in_N05_cross_.7_depth_while_prior_group_not_terminal; latch_trigger_once",
        "future_G3_remains_obligation_without_invisible_enemy_or_budget_until_whole_group_admission",
        "save_latest_complete_same_root_with_latch_dependencies_statuses_DOT_old_projectile_and_RNG",
