          "text": "        if (Clip!=TEXT(\"attack\") && Clip!=TEXT(\"hurt\") && Clip!=TEXT(\"secondary\") && Clip!=TEXT(\"dodge\") && Clip!=TEXT(\"equip\") && Clip!=TEXT(\"equip_weapon\") && Clip!=TEXT(\"equip_armor\") && !F->bDead)"
