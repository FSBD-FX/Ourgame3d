          "text": "    if (Dodge.State().Phase==DungeonDodge::EPhase::Dodging) SyncDodgeAction();"
        },
        {
          "line": 1898,
          "text": "    else if (WeaponSkills.State().Action.Active) SyncWeaponSkillAction();"
        },
