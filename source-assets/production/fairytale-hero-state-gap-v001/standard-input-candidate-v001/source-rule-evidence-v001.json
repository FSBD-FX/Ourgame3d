      ]
    },
    {
      "source": {
        "path": "F:/Ourgame/UnrealGame/Source/CodexDungeon/DungeonDodge.h",
        "bytes": 14663,
        "sha256": "375ee1aa3d83612a3c686f0b1a6a6d322c97e247ea957c3d7380dcd431fd9ec2"
      },
      "first_line": 58,
      "last_line": 61,
      "meaning": "Protected uses absolute Start+ boundaries and clips at actual interruption",
      "exact_lines": [
        {
          "line": 58,
          "text": " static bool Protected(const FRecord& R,double T) {"
        },
        {
          "line": 59,
          "text": "  const double End=R.Finish==EFinish::None?R.Start+IFrameEnd:std::min(R.Start+IFrameEnd,R.FinishedAt);"
        },
        {
          "line": 60,
          "text": "  return T>=R.Start+IFrameStart&&T<End;"
        },
        {
          "line": 61,
          "text": " }"
        }
      ]
    },
    {
      "source": {
        "path": "F:/Ourgame/UnrealGame/Source/CodexDungeon/DungeonDodge.h",
        "bytes": 14663,
        "sha256": "375ee1aa3d83612a3c686f0b1a6a6d322c97e247ea957c3d7380dcd431fd9ec2"
      },
      "first_line": 138,
      "last_line": 148,
      "meaning": "Normalized MoveIntent or zero-intent Facing fallback; no facing mutation",
      "exact_lines": [
        {
          "line": 138,
          "text": " FResult TryStart(double Now,const FContext& C) {"
        },
        {
          "line": 139,
          "text": "  if(!ValidState(S)||!Finite(Now)||Now!=S.Time||S.Phase!=EPhase::Idle||Now<S.ReadyAt||!C.FreshPress||!C.Grounded||!C.CanStart||(C.Facing!=1&&C.Facing!=-1)||!ValidPoint(C.MoveIntent))return {};"
        },
        {
          "line": 140,
          "text": "  FRecord R;R.ActionId=S.NextActionId;R.StartEventId=S.NextEventId;R.Origin=S.Position;R.Start=Now;R.End=Now+Duration;R.ReadyAt=Now+Cooldown;"
        },
        {
          "line": 141,
          "text": "  if(S.LastPositionReceipt.Id&&S.LastPositionReceipt.AfterActionId==S.NextActionId-1)R.OriginReceipt=S.LastPositionReceipt;"
        },
        {
          "line": 142,
          "text": "  const double Scale=std::max(std::abs(C.MoveIntent.X),std::abs(C.MoveIntent.Y));"
        },
        {
          "line": 143,
          "text": "  if(Scale>0) { const FPoint Small{C.MoveIntent.X/Scale,C.MoveIntent.Y/Scale};const double Norm=std::hypot(Small.X,Small.Y);R.Direction={Small.X/Norm,Small.Y/Norm}; }"
        },
        {
          "line": 144,
          "text": "  else R.Direction={static_cast<double>(C.Facing),0};"
        },
        {
          "line": 145,
          "text": "  if(!TimingsValid(R)||!ValidPoint(PositionAt(R,Distance)))return {};"
        },
        {
          "line": 146,
          "text": "  auto Next=S;FResult Out;Next.Records.push_back(R);++Next.NextActionId;Next.ReadyAt=R.ReadyAt;Next.Phase=EPhase::Dodging;Emit(Next,Out,EEventKind::Started,Now);"
        },
        {
          "line": 147,
          "text": "  if(!ValidState(Next))return {};S=std::move(Next);Out.Accepted=true;return Out;"
        },
        {
          "line": 148,
          "text": " }"
        }
      ]
    },
    {
      "source": {
        "path": "F:/Ourgame/UnrealGame/Source/CodexDungeon/DungeonDodge.h",
        "bytes": 14663,
        "sha256": "375ee1aa3d83612a3c686f0b1a6a6d322c97e247ea957c3d7380dcd431fd9ec2"
      },
      "first_line": 149,
      "last_line": 167,
      "meaning": "Blocked travel freezes, completion only at unchanged native End",
      "exact_lines": [
        {
          "line": 149,
          "text": " FResult StepTo(double Now,const FSweep& Sweep={}) {"
        },
        {
          "line": 150,
          "text": "  if(!ValidState(S)||!Finite(Now)||Now<S.Time)return {};"
        },
        {
          "line": 151,
          "text": "  auto Next=S;FResult Out;"
        },
        {
          "line": 152,
          "text": "  if(Next.Phase==EPhase::Dodging) {"
        },
        {
          "line": 153,
          "text": "   auto& R=Next.Records.back();const double MoveEnd=std::min(Now,R.End);"
        },
        {
          "line": 154,
          "text": "   if(MoveEnd>Next.Time&&R.Block==EBlock::None) {"
        },
        {
          "line": 155,
          "text": "    const double TargetTravel=TravelAt(R,MoveEnd);FSweepRequest Q;Q.From=Next.Position;Q.To=PositionAt(R,TargetTravel);Q.FromTime=Next.Time;Q.ToTime=MoveEnd;Q.ActionId=R.ActionId;FSweepResult Hit;"
        },
        {
          "line": 156,
          "text": "    if(!ValidPoint(Q.To)||!ReadSweep(Sweep,Q,Hit))return {};"
        },
        {
          "line": 157,
          "text": "    if(Hit.HitWall||Hit.HitBody) {"
        },
        {
          "line": 158,
          "text": "     const bool Wall=Hit.HitWall&&(!Hit.HitBody||Hit.WallFraction<=Hit.BodyFraction);const double Fraction=Wall?Hit.WallFraction:Hit.BodyFraction;"
        },
        {
          "line": 159,
          "text": "     R.Block=Wall?EBlock::Wall:EBlock::Body;R.BlockedAt=Fraction==1?MoveEnd:Next.Time+(MoveEnd-Next.Time)*Fraction;"
        },
        {
          "line": 160,
          "text": "     R.Travelled=Fraction==1?TargetTravel:R.Travelled+(TargetTravel-R.Travelled)*Fraction;Next.Position=PositionAt(R,R.Travelled);R.BlockEventId=Next.NextEventId;Emit(Next,Out,EEventKind::Blocked,R.BlockedAt,R.Block);"
        },
        {
          "line": 161,
          "text": "    } else { R.Travelled=TargetTravel;Next.Position=Q.To; }"
        },
        {
          "line": 162,
          "text": "   }"
        },
        {
          "line": 163,
          "text": "   Next.Time=MoveEnd;"
        },
        {
          "line": 164,
          "text": "   if(MoveEnd==R.End) { R.Finish=EFinish::Completed;R.FinishedAt=R.End;R.FinishEventId=Next.NextEventId;Next.Phase=EPhase::Idle;Emit(Next,Out,EEventKind::Completed,R.End,R.Block,R.Finish); }"
        },
        {
          "line": 165,
          "text": "  }"
        },
        {
          "line": 166,
          "text": "  Next.Time=Now;if(!ValidState(Next))return {};S=std::move(Next);Out.Accepted=true;return Out;"
        },
        {
          "line": 167,
          "text": " }"
        }
      ]
    },
    {
      "source": {
        "path": "F:/Ourgame/UnrealGame/Source/CodexDungeon/DungeonDodge.h",
        "bytes": 14663,
        "sha256": "375ee1aa3d83612a3c686f0b1a6a6d322c97e247ea957c3d7380dcd431fd9ec2"
      },
      "first_line": 172,
      "last_line": 183,
      "meaning": "Poise/death interruptions and protected direct contact restriction",
      "exact_lines": [
        {
          "line": 172,
          "text": "  if(!ValidState(S)||!Finite(Now)||Now!=S.Time||S.Phase==EPhase::Dead||(Reason!=EFinish::PoiseBreak&&Reason!=EFinish::Death))return {};"
        },
        {
          "line": 173,
          "text": "  if(Reason==EFinish::PoiseBreak&&(S.Phase!=EPhase::Dodging||Protected(S.Records.back(),Now)))return {};"
        },
        {
          "line": 174,
          "text": "  auto Next=S;FResult Out;"
        },
        {
          "line": 175,
          "text": "  if(Next.Phase==EPhase::Dodging) { auto& R=Next.Records.back();R.Finish=Reason;R.FinishedAt=Now;R.FinishEventId=Next.NextEventId;Next.Phase=EPhase::Idle;Emit(Next,Out,EEventKind::Interrupted,Now,R.Block,Reason); }"
        },
        {
          "line": 176,
          "text": "  if(Reason==EFinish::Death) { Next.Phase=EPhase::Dead;Next.DeadAt=Now;Next.DeathEventId=Next.NextEventId;Emit(Next,Out,EEventKind::Died,Now,EBlock::None,Reason); }"
        },
        {
          "line": 177,
          "text": "  if(!ValidState(Next))return {};S=std::move(Next);Out.Accepted=true;return Out;"
        },
        {
          "line": 178,
          "text": " }"
        },
        {
          "line": 179,
          "text": " // While active, future scheduled intervals are promises subject to subsequent"
        },
        {
          "line": 180,
          "text": " // real interruption. Refresh intervals after each interruption before contacts."
        },
        {
          "line": 181,
          "text": " // Historical intervals remain available for continuous caller damage queries."
        },
        {
          "line": 182,
          "text": " bool IsDirectInvulnerableAt(double HitTime) const { if(!Finite(HitTime))return false;for(const auto& R:S.Records)if(Protected(R,HitTime))return true;return false; }"
        },
        {
          "line": 183,
          "text": " std::vector<FInterval> DirectInvulnerabilityIntervals() const { std::vector<FInterval> Out;for(const auto& R:S.Records){const double End=R.Finish==EFinish::None?R.Start+IFrameEnd:std::min(R.Start+IFrameEnd,R.FinishedAt);if(End>R.Start+IFrameStart)Out.push_back({R.ActionId,R.Start+IFrameStart,End});}return Out; }"
        }
      ]
    },
    {
      "source": {
        "path": "F:/Ourgame/UnrealGame/Source/CodexDungeon/DungeonFighter.cpp",
        "bytes": 121495,
        "sha256": "c31ae4c10a52707ba555864012a1ef920c855328e83a6d8d478a8ba3fd36cebb"
      },
      "first_line": 766,
      "last_line": 790,
      "meaning": "Real dodge admission, shared equipment/attack gates and successful action interrupts",
      "exact_lines": [
        {
          "line": 766,
          "text": "bool ADungeonFighter::TryBeginDodge(FVector2D MoveIntent, bool FreshPress)"
        },
        {
          "line": 767,
          "text": "{"
        },
        {
          "line": 768,
          "text": "    if(RunInstallBlocksFighter(*this))return false;"
        },
        {
          "line": 769,
          "text": "    auto Game=GetWorld()->GetAuthGameMode<ADungeonGameMode>();"
        },
        {
          "line": 770,
          "text": "    if (!Game || Game->bGameOver || Game->bWaitingForStart || bEnemy || bDead || HurtTime>0.f"
        },
        {
          "line": 771,
          "text": "        || Combat.State().Action.Active || AttackCooldown>0.f"
        },
        {
          "line": 772,
          "text": "        || (AttackTime>0.f&&!(WeaponSkills.State().Action.Active&&WeaponSkills.State().Action.Type==DungeonWeaponActions::EAction::Reload))"
        },
        {
          "line": 773,
          "text": "        || (WeaponSkills.State().Action.Active && WeaponSkills.State().Action.Type!=DungeonWeaponActions::EAction::Reload)"
        },
        {
          "line": 774,
          "text": "        || Game->GetSimulationTime()!=Dodge.State().Time) return false;"
        },
        {
          "line": 775,
          "text": "    if (IsEquipmentBound() && Game->GetEquipmentView().Action.Active"
        },
        {
          "line": 776,
          "text": "        && Game->GetEquipmentView().Action.Kind==EDungeonEquipmentActionKind::SwitchWeapon) return false;"
        },
        {
          "line": 777,
          "text": "    DungeonDodge::FContext C;"
        },
        {
          "line": 778,
          "text": "    C.FreshPress=FreshPress; C.Grounded=JumpHeight<=KINDA_SMALL_NUMBER && JumpVelocity<=0.f;"
        },
        {
          "line": 779,
          "text": "    C.CanStart=true; C.Facing=Facing<0.f?-1:1; C.MoveIntent={MoveIntent.X,MoveIntent.Y};"
        },
        {
          "line": 780,
          "text": "    // A failed request has no cancellation, receipt or resource side effects."
        },
        {
          "line": 781,
          "text": "    const auto R=Dodge.TryStart(Dodge.State().Time,C);"
        },
        {
          "line": 782,
          "text": "    if (!R.Accepted) return false;"
        },
        {
          "line": 783,
          "text": "    if (IsEquipmentBound()) Game->CancelEquipmentAction();"
        },
        {
          "line": 784,
          "text": "    ArmorChangeRemaining=0.f; PendingArmorId.Reset();"
        },
        {
          "line": 785,
          "text": "    Combat.Interrupt(DungeonContentCombat::EInterruptReason::ExclusiveAction);"
        },
        {
          "line": 786,
          "text": "    WeaponSkills.Interrupt(DungeonWeaponActions::EInterrupt::ExclusiveAction);"
        },
        {
          "line": 787,
          "text": "    if(IsEquipmentBound())Game->ObservePendingActionAudio(this);"
        },
        {
          "line": 788,
          "text": "    ClearPendingAttackInput();"
        },
        {
          "line": 789,
          "text": "    SyncDodgeAction();"
        },
        {
          "line": 790,
          "text": "    return true;"
        }
      ]
    },
    {
      "source": {
        "path": "F:/Ourgame/UnrealGame/Source/CodexDungeon/DungeonFighter.cpp",
        "bytes": 121495,
        "sha256": "c31ae4c10a52707ba555864012a1ef920c855328e83a6d8d478a8ba3fd36cebb"
      },
      "first_line": 795,
      "last_line": 803,
      "meaning": "Public native Dodge state drives position and presentation age",
      "exact_lines": [
        {
          "line": 795,
          "text": "void ADungeonFighter::SyncDodgeAction()"
        },
        {
          "line": 796,
          "text": "{"
        },
        {
          "line": 797,
          "text": "    const auto& S=Dodge.State();"
        },
        {
          "line": 798,
          "text": "    if (S.Phase!=DungeonDodge::EPhase::Dodging || S.Records.empty()) return;"
        },
        {
          "line": 799,
          "text": "    SetActorLocation(FVector(S.Position.X,S.Position.Y,0.0));"
        },
        {
          "line": 800,
          "text": "    const auto& R=S.Records.back();"
        },
        {
          "line": 801,
          "text": "    AttackTime=0.f; ComboStage=0; AttackPhase=TEXT(\"dodge\");"
        },
        {
          "line": 802,
          "text": "    AnimationName=TEXT(\"dodge\"); AnimationTime=float(S.Time-R.Start);"
        },
        {
          "line": 803,
          "text": "    bMoving=R.Block==DungeonDodge::EBlock::None;"
        }
      ]
    },
    {
      "source": {
        "path": "F:/Ourgame/UnrealGame/Source/CodexDungeon/DungeonFighter.cpp",
        "bytes": 121495,
        "sha256": "c31ae4c10a52707ba555864012a1ef920c855328e83a6d8d478a8ba3fd36cebb"
      },
      "first_line": 1325,
      "last_line": 1330,
      "meaning": "Dead/dodge/hurt/exclusive actions reject new attack admission",
      "exact_lines": [
        {
          "line": 1325,
          "text": "bool ADungeonFighter::CanStartAttack() const"
        },
        {
          "line": 1326,
          "text": "{"
        },
        {
          "line": 1327,
          "text": "    if(RunInstallBlocksFighter(*this))return false;"
        },
        {
          "line": 1328,
          "text": "    return !StoneKnight && !StoneBat && !StoneGuard && GetEquipmentActionDeadline()<=0 && Dodge.State().Phase!=DungeonDodge::EPhase::Dodging && !WeaponSkills.State().Action.Active && !bDead && AttackTime <= 0.f && AttackCooldown <= 0.f && HurtTime <= 0.f && ArmorChangeRemaining <= 0.f"
        },
        {
          "line": 1329,
          "text": "        && !(JumpHeight > 0.f && bAirPrimarySpent);"
        },
        {
          "line": 1330,
          "text": "}"
        }
      ]
    },
    {
      "source": {
        "path": "F:/Ourgame/UnrealGame/Source/CodexDungeon/DungeonFighter.cpp",
        "bytes": 121495,
        "sha256": "c31ae4c10a52707ba555864012a1ef920c855328e83a6d8d478a8ba3fd36cebb"
      },
      "first_line": 1435,
      "last_line": 1441,
      "meaning": "Dead or unaccepted protected direct contacts do not newly apply hit",
      "exact_lines": [
        {
          "line": 1435,
          "text": "void ADungeonFighter::ApplyCombatHitInternal(float Damage, ADungeonFighter* Attacker, float Stagger, bool PreviouslyAccepted,"
        },
        {
          "line": 1436,
          "text": "    bool Magic, bool DamageOverTime, bool PreserveHurtProtection)"
        },
        {
          "line": 1437,
          "text": "{"
        },
        {
          "line": 1438,
          "text": "    if (bDead || (!DamageOverTime&&!PreviouslyAccepted && !CanReceiveDirectHit()) || !FMath::IsFinite(Damage) || Damage <= 0.f)"
        },
        {
          "line": 1439,
          "text": "    {"
        },
        {
          "line": 1440,
          "text": "        return;"
        },
        {
          "line": 1441,
          "text": "    }"
        }
      ]
    },
    {
      "source": {
        "path": "F:/Ourgame/UnrealGame/Source/CodexDungeon/DungeonFighter.cpp",
        "bytes": 121495,
        "sha256": "c31ae4c10a52707ba555864012a1ef920c855328e83a6d8d478a8ba3fd36cebb"
      },
      "first_line": 1486,
      "last_line": 1529,
      "meaning": "DoT vs direct hit, poise break/Hurt, lethal interrupts",
      "exact_lines": [
        {
          "line": 1486,
          "text": "    Health = FMath::Max(0.f, Health - ActualDamage);"
        },
        {
          "line": 1487,
          "text": "    ArmorChangeRemaining = 0.f; PendingArmorId.Reset();"
        },
        {
          "line": 1488,
          "text": "    if (DamageOverTime)"
        },
        {
          "line": 1489,
          "text": "    {"
        },
        {
          "line": 1490,
          "text": "        // Status ticks bypass direct protection and never create hurt/poise/push."
        },
        {
          "line": 1491,
          "text": "        if (Health<=0.f)"
        },
        {
          "line": 1492,
          "text": "        {"
        },
        {
          "line": 1493,
          "text": "            bDead=true;AttackTime=0.f;Combat.Interrupt(DungeonContentCombat::EInterruptReason::Death);"
        },
        {
          "line": 1494,
          "text": "            InterruptWeaponActionForHit(DungeonWeaponActions::EInterrupt::Death);"
        },
        {
          "line": 1495,
          "text": "            if (!bEnemy) Dodge.Interrupt(Dodge.State().Time,DungeonDodge::EFinish::Death);"
        },
        {
          "line": 1496,
          "text": "            AnimationName=TEXT(\"death\");AnimationTime=0;"
        },
        {
          "line": 1497,
          "text": "            if (auto Game=GetWorld()->GetAuthGameMode<ADungeonGameMode>()) Game->OnFighterDied(this);"
        },
        {
          "line": 1498,
          "text": "        }"
        },
        {
          "line": 1499,
          "text": "        return;"
        },
        {
          "line": 1500,
          "text": "    }"
        },
        {
          "line": 1501,
          "text": "    if (USoundBase* Impact = LoadObject<USoundBase>(nullptr,TEXT(\"/Game/ThirdParty/Kenney/ImpactSounds/ImpactLight/SW_ImpactLight.SW_ImpactLight\")))"
        },
        {
          "line": 1502,
          "text": "        UGameplayStatics::PlaySound2D(this,Impact,0.45f,bEnemy?1.15f:0.9f);"
        },
        {
          "line": 1503,
          "text": "    HitFlash = 0.22f;"
        },
        {
          "line": 1504,
          "text": "    if (!PreserveHurtProtection)"
        },
        {
          "line": 1505,
          "text": "    {InvulnerableTime = bEnemy ? 0.18f : 0.65f;HurtProtectionSource={};}"
        },
        {
          "line": 1506,
          "text": "    bool Broken = bEnemy; // Historical generic enemies remain prototype adapters."
        },
        {
          "line": 1507,
          "text": "    if (!bEnemy && PoiseProtection <= 0.f)"
        },
        {
          "line": 1508,
          "text": "    {"
        },
        {
          "line": 1509,
          "text": "        PoiseAccumulation += Stagger >= 0.f ? Stagger : Attacker ? Attacker->GetAttackStagger() : 13.f;"
        },
        {
          "line": 1510,
          "text": "        PoiseDecayDelay = 1.f;"
        },
        {
          "line": 1511,
          "text": "        if (PoiseAccumulation >= GetPoiseThreshold())"
        },
        {
          "line": 1512,
          "text": "        {"
        },
        {
          "line": 1513,
          "text": "            Broken = true; PoiseAccumulation = 0.f; PoiseProtection = 1.f;"
        },
        {
          "line": 1514,
          "text": "        }"
        },
        {
          "line": 1515,
          "text": "    }"
        },
        {
          "line": 1516,
          "text": "    if (Broken || Health <= 0.f)"
        },
        {
          "line": 1517,
          "text": "    {"
        },
        {
          "line": 1518,
          "text": "        HurtTime = bEnemy ? .2f : .4f;"
        },
        {
          "line": 1519,
          "text": "        AttackTime = 0.f;"
        },
        {
          "line": 1520,
          "text": "        Combat.Interrupt(Health <= 0.f ? DungeonContentCombat::EInterruptReason::Death"
        },
        {
          "line": 1521,
          "text": "            : DungeonContentCombat::EInterruptReason::PoiseBreak);"
        },
        {
          "line": 1522,
          "text": "        InterruptWeaponActionForHit(Health <= 0.f ? DungeonWeaponActions::EInterrupt::Death"
        },
        {
          "line": 1523,
          "text": "            : DungeonWeaponActions::EInterrupt::PoiseBreak);"
        },
        {
          "line": 1524,
          "text": "        if (!bEnemy) Dodge.Interrupt(Dodge.State().Time,Health<=0.f?DungeonDodge::EFinish::Death:DungeonDodge::EFinish::PoiseBreak);"
        },
        {
          "line": 1525,
          "text": "        SkillWindows.clear();"
        },
        {
          "line": 1526,
          "text": "        if (auto Game=GetWorld()->GetAuthGameMode<ADungeonGameMode>()) Game->CancelWorldWeaponWindows(GetRuntimeEntityId());"
        },
        {
          "line": 1527,
          "text": "        AnimationTime = 0.f;"
        },
        {
          "line": 1528,
          "text": "        AnimationName = Health > 0.f ? TEXT(\"hurt\") : TEXT(\"death\");"
        },
        {
          "line": 1529,
          "text": "    }"
        }
      ]
    },
    {
      "source": {
