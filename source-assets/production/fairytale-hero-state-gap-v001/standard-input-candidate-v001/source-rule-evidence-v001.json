      "meaning": "Native duration, travel, iframe and cooldown constants",
      "exact_lines": [
        {
          "line": 11,
          "text": "inline constexpr double Duration = .40;"
        },
        {
          "line": 12,
          "text": "inline constexpr double Distance = 185.;"
        },
        {
          "line": 13,
          "text": "inline constexpr double Speed = 462.5;"
        },
        {
          "line": 14,
          "text": "inline constexpr double IFrameStart = .06;"
        },
        {
          "line": 15,
          "text": "inline constexpr double IFrameEnd = .20;"
