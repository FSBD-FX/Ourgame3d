      },
      "first_line": 1205,
      "last_line": 1228,
      "meaning": "Actual body capture carries bAlive=false after death",
      "exact_lines": [
        {
          "line": 1205,
          "text": "TArray<FDungeonKnightBody> ADungeonGameMode::CaptureKnightBodies() const"
        },
        {
          "line": 1206,
          "text": "{"
        },
        {
          "line": 1207,
          "text": "    TArray<FDungeonKnightBody> Bodies;"
        },
        {
          "line": 1208,
          "text": "    const auto Capture = [this,&Bodies](ADungeonFighter* Fighter)"
        },
        {
          "line": 1209,
          "text": "    {"
        },
        {
          "line": 1210,
          "text": "        if (!IsValid(Fighter)||!Fighter->GetRuntimeEntityId()) return;"
        },
        {
          "line": 1211,
          "text": "        FDungeonKnightBody B;"
        },
        {
          "line": 1212,
          "text": "        B.Fighter = Fighter; B.EntityId = Fighter->GetRuntimeEntityId();"
        },
        {
          "line": 1213,
          "text": "        B.Start = B.End = Fighter->GetGroundPosition();"
        },
        {
          "line": 1214,
          "text": "        B.StartHeight = B.EndHeight = Fighter->GetCombatHeight();"
        },
        {
          "line": 1215,
          "text": "        B.BodyHalfExtent = Fighter->GetCombatBodyHalfExtent();"
        },
        {
          "line": 1216,
          "text": "        B.bBlocksBody = !Fighter->StoneBat || B.StartHeight<=40.;"
        },
        {
          "line": 1217,
          "text": "        B.bAlive = !Fighter->bDead;"
        },
        {
          "line": 1218,
          "text": "        B.bCanTakeDamage = Fighter->CanReceiveDirectHit();"
        },
        {
          "line": 1219,
          "text": "        B.bUseTimedDamageAdmission=true;"
        },
        {
          "line": 1220,
          "text": "        if (Fighter->InvulnerableTime>0.f)"
        },
        {
          "line": 1221,
          "text": "            B.DirectInvulnerabilityIntervals.Add({SimulationTime,SimulationTime+double(Fighter->InvulnerableTime)});"
        },
        {
          "line": 1222,
          "text": "        for (const auto& I:Fighter->Dodge.DirectInvulnerabilityIntervals())"
        },
        {
          "line": 1223,
          "text": "            B.DirectInvulnerabilityIntervals.Add({I.Start,I.EndExclusive});"
        },
        {
          "line": 1224,
          "text": "        Bodies.Add(B);"
        },
        {
          "line": 1225,
          "text": "    };"
        },
        {
          "line": 1226,
          "text": "    Capture(PlayerFighter);"
        },
        {
          "line": 1227,
          "text": "    for (ADungeonFighter* Enemy : Enemies) Capture(Enemy);"
        },
        {
          "line": 1228,
          "text": "    return Bodies;"
        }
      ]
    },
