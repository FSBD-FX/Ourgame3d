      "last_line": 1896,
      "meaning": "Game-over uses terminal animation, does not advance SimulationTime",
      "exact_lines": [
        {
          "line": 1888,
          "text": "    if (!PlayerFighter || !FMath::IsFinite(DeltaSeconds) || DeltaSeconds <= 0.f) return;"
        },
        {
          "line": 1889,
          "text": "    if (bGameOver)"
        },
        {
          "line": 1890,
          "text": "    {"
        },
        {
          "line": 1891,
          "text": "        PlayerFighter->AdvanceTerminalPresentation(DeltaSeconds);"
        },
        {
          "line": 1892,
          "text": "        for (ADungeonFighter* Enemy : Enemies)"
        },
