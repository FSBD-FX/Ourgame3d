          "text": "    else if (!(IsContentMelee() && AttackTime > 0.f))"
        },
        {
          "line": 1900,
          "text": "    {"
        },
        {
          "line": 1901,
          "text": "        const FString Next=AttackTime > 0.f ? TEXT(\"attack\") : HurtTime > 0.f ? TEXT(\"hurt\")"
