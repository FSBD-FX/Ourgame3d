      },
      "first_line": 1799,
      "last_line": 1805,
      "meaning": "Terminal display clock continues without gameplay tick",
      "exact_lines": [
        {
          "line": 1799,
          "text": "void ADungeonFighter::AdvanceTerminalPresentation(float DeltaSeconds)"
        },
        {
          "line": 1800,
          "text": "{"
        },
        {
          "line": 1801,
          "text": "    if(RunInstallBlocksFighter(*this))return;"
        },
        {
          "line": 1802,
          "text": "    if (!bDead || !FMath::IsFinite(DeltaSeconds) || DeltaSeconds <= 0.f) return;"
        },
        {
          "line": 1803,
          "text": "    // Terminal display only: no kernel/driver clock, movement, input, damage or resource tick."
        },
        {
          "line": 1804,
          "text": "    AnimationTime += DeltaSeconds;"
        },
        {
          "line": 1805,
          "text": "    JumpHeight = FMath::Max(0.f, JumpHeight-360.f*DeltaSeconds);"
        }
      ]
    },
    {
      "source": {
        "path": "F:/Ourgame/UnrealGame/Source/CodexDungeon/DungeonFighter.cpp",
        "bytes": 121495,
        "sha256": "c31ae4c10a52707ba555864012a1ef920c855328e83a6d8d478a8ba3fd36cebb"
      },
      "first_line": 1815,
      "last_line": 1829,
      "meaning": "Hurt countdown; dead branch advances only death presentation and height",
      "exact_lines": [
        {
          "line": 1815,
          "text": "    }"
        },
        {
          "line": 1816,
          "text": "    HitFlash = FMath::Max(0.f, HitFlash - DeltaSeconds);"
        },
        {
          "line": 1817,
          "text": "    InvulnerableTime = FMath::Max(0.f, InvulnerableTime - DeltaSeconds);"
        },
        {
          "line": 1818,
          "text": "    HurtTime = FMath::Max(0.f, HurtTime - DeltaSeconds);"
        },
        {
          "line": 1819,
          "text": "    AttackCooldown = FMath::Max(0.f, AttackCooldown - DeltaSeconds);"
        },
        {
          "line": 1820,
          "text": "    PoiseProtection = FMath::Max(0.f, PoiseProtection - DeltaSeconds);"
        },
        {
          "line": 1821,
          "text": "    const float DecayTime = FMath::Max(0.f, DeltaSeconds - PoiseDecayDelay);"
        },
        {
          "line": 1822,
          "text": "    PoiseDecayDelay = FMath::Max(0.f, PoiseDecayDelay - DeltaSeconds);"
        },
        {
          "line": 1823,
          "text": "    PoiseAccumulation = FMath::Max(0.f, PoiseAccumulation - 20.f * DecayTime);"
        },
        {
          "line": 1824,
          "text": "    if (bDead)"
        },
        {
          "line": 1825,
          "text": "    {"
        },
        {
          "line": 1826,
          "text": "        JumpHeight = FMath::Max(0.f, JumpHeight - 360.f * DeltaSeconds);"
        },
        {
          "line": 1827,
          "text": "        SetAnimation(TEXT(\"death\"), DeltaSeconds);"
        },
        {
          "line": 1828,
          "text": "        return;"
        },
        {
          "line": 1829,
          "text": "    }"
        }
      ]
    },
