      },
      "first_line": 2329,
      "last_line": 2339,
      "meaning": "Player death sets game-over once; restart is separate input route",
      "exact_lines": [
        {
          "line": 2329,
          "text": "    if (Fighter->StoneKnight && !Fighter->StoneKnight->ClaimDeathReward()) return;"
        },
        {
          "line": 2330,
          "text": "    if (Fighter->StoneBat && !Fighter->StoneBat->ClaimDeathReward()) return;"
        },
        {
