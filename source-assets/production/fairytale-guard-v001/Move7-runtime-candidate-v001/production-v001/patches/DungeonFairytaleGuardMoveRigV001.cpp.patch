+bool Solve(const FSolveInput& Input,const FProfile& Source,FRigSolution& Out,FString& Diagnostic)
+{
+ if(!SameProfile(Source,Profile())||!Source.SourceClosureVerified||!Source.TrialAllowed||Source.FinalAccepted
+  ||Source.TrialApprovalRecord.IsEmpty())return Reject(Diagnostic,TEXT("Move7 frozen profile or bounded trial approval differs"));
+ if(!Input.EntityId||Input.AcceptedPathOwnerId!=Input.EntityId||!std::isfinite(Input.AcceptedDistance)||Input.AcceptedDistance<0.
+  ||(Input.Facing!=1&&Input.Facing!=-1)||!Finite(Input.Context.GroundScreen)||!std::isfinite(Input.Context.UIScale)
+  ||Input.Context.UIScale<=0.||Input.Context.JumpHeight!=0.)return Reject(Diagnostic,TEXT("Move7 owner, accepted path, facing or flat screen domain invalid"));
+ const double D=Source.TargetBodyHeight/Source.StandingExtent,UI=Input.Context.UIScale;
+ FRigSolution Candidate;Candidate.Facing=Input.Facing;Candidate.AcceptedDistance=Input.AcceptedDistance;
+ Candidate.ProfileId=Source.ProfileId;Candidate.ProfileSHA256=Source.ProfileSHA256;Candidate.SourceSnapshotSHA256=Source.SourceSnapshotSHA256;
+ Candidate.CyclePosition=std::fmod(Input.AcceptedDistance,Source.CycleWorld);
+ Candidate.Half=Candidate.CyclePosition>=Source.HalfCycleWorld?1:0;
+ Candidate.U=(Candidate.CyclePosition-Source.HalfCycleWorld*Candidate.Half)/Source.HalfCycleWorld;
+ const double BobSin=std::sin(2.*MovePi*Candidate.CyclePosition/Source.CycleWorld);
+ Candidate.BodyRise=Source.BodyBob*BobSin*BobSin;Candidate.ReflectionCount=Input.Facing<0?1:0;
+ FCanonicalPart Canonical[7];const auto& Body=Source.Sources[0];
+ Canonical[0].Pivot=Body.Markers[0].Point;
+ Canonical[0].Anchor=Canonical[0].Pivot-Source.SourceGround-FVector2D(0.,Candidate.BodyRise/D);
+ for(int32 Side=0;Side<2;++Side)
+ {
+  const bool Near=Side==0;const int32 Base=Near?1:4;
+  const auto& Thigh=Source.Sources[Base];const auto& Shin=Source.Sources[Base+1];const auto& Foot=Source.Sources[Base+2];
+  const FVector2D H0=Body.Markers[Near?2:3].Point-Source.SourceGround;
+  const FVector2D H=H0-FVector2D(0.,Candidate.BodyRise/D);
+  const FVector2D ThighAxis=Thigh.Markers[1].Point-Thigh.Markers[0].Point;
+  const FVector2D ShinAxis=Shin.Markers[1].Point-Shin.Markers[0].Point;
+  const double Kit=Thigh.ComponentToRestScale,L1=ThighAxis.Size()*Kit,L2=ShinAxis.Size()*Kit;
+  const double FootAngle=-Angle(Foot.Markers[2].Point-Foot.Markers[1].Point);
+  const FVector2D Midsole=Rotate((Foot.Markers[1].Point+Foot.Markers[2].Point)*.5-Foot.Markers[0].Point,FootAngle)*Kit;
+  // Frozen original alpha>=128 core offsets. Opaque heel/toe markers sit above
+  // these sole rows; they must not be normalized to ground or retuned per pose.
+  const double CoreSole=Near?60.839999999999996:72.69764651497574;
+  const bool Stance=(Candidate.Half==0)==Near;
+  const double X=Stance?Source.FootHalfStance-2.*Source.FootHalfStance*Candidate.U:-Source.FootHalfStance+2.*Source.FootHalfStance*Candidate.U;
+  const double SwingSin=std::sin(MovePi*Candidate.U),Lift=Stance?0.:Source.SwingLift*SwingSin*SwingSin;
+  const FVector2D T(H0.X+X/D-Midsole.X,-CoreSole-Lift/D),V=T-H;
+  const double Length=V.Size();
+  if(!std::isfinite(Length)||!(FMath::Abs(L1-L2)<Length&&Length<L1+L2))
+   return Reject(Diagnostic,TEXT("Move7 fixed chain unreachable; stretch and clamp are prohibited"));
+  const FVector2D Unit=V/Length;const double A=(L1*L1-L2*L2+Length*Length)/(2.*Length),Rad=L1*L1-A*A;
+  if(!std::isfinite(Rad)||Rad<0.)return Reject(Diagnostic,TEXT("Move7 fixed chain radicand invalid"));
+  const int32 Branch=Near?Source.NearBranch:Source.FarBranch;
+  const FVector2D K=H+A*Unit+double(Branch)*std::sqrt(Rad)*FVector2D(-Unit.Y,Unit.X);
+  if(!Finite(K)||FMath::Abs((K-H).Size()-L1)>=1.e-9||FMath::Abs((T-K).Size()-L2)>=1.e-9)
+   return Reject(Diagnostic,TEXT("Move7 fixed chain length changed"));
+  Canonical[Base]={Thigh.Markers[0].Point,H,Angle(K-H)-Angle(ThighAxis)};
+  Canonical[Base+1]={Shin.Markers[0].Point,K,Angle(T-K)-Angle(ShinAxis)};
+  Canonical[Base+2]={Foot.Markers[0].Point,T,FootAngle};
+ }
+ for(EComponent Component:Source.LayerOrder)
+ {
+  const int32 I=int32(Component);const auto& S=Source.Sources[I];const auto& C=Canonical[I];
+  const double Scale=D*S.ComponentToRestScale*UI,Size=double(Source.CanvasSize)*Scale;
+  if(!std::isfinite(Scale)||Scale<=0.||!std::isfinite(float(Scale))||float(Scale)<=0.f||!std::isfinite(Size))
+   return Reject(Diagnostic,TEXT("Move7 fixed scale is outside float Canvas domain"));
+  FPartPose Part;Part.Component=Component;Part.TexturePath=S.TexturePath;Part.SourceSHA256=S.SourceSHA256;
+  Part.SourceRGBASHA256=S.SourceRGBASHA256;Part.NativeBatchId=S.NativeBatchId;Part.ComponentToRestScale=S.ComponentToRestScale;
+  Part.SourcePivot=C.Pivot;Part.ArtAnchorFromGround=C.Anchor;Part.SourceRotationRadians=C.Angle;
+  Part.ScreenAnchor=Input.Context.GroundScreen+FVector2D(double(Input.Facing)*D*C.Anchor.X*UI,D*C.Anchor.Y*UI);
+  auto& Q=Part.Quad;Q.RotationPivotUV=C.Pivot/double(Source.CanvasSize);double Degrees=C.Angle*180./MovePi;
+  if(Input.Facing<0){Q.RotationPivotUV.X=1.-Q.RotationPivotUV.X;Degrees=-Degrees;Q.U=1.f;Q.UL=-1.f;}
+  const FVector2D Top=Part.ScreenAnchor-FVector2D(Size*Q.RotationPivotUV.X,Size*Q.RotationPivotUV.Y);
+  if(!Finite(Top)||!Finite(Part.ScreenAnchor))return Reject(Diagnostic,TEXT("Move7 screen anchor nonfinite"));
+  Q.X=float(Top.X);Q.Y=float(Top.Y);Q.Width=Q.Height=float(Size);Q.RotationDegrees=float(Degrees);
+  if(!UsableCanvasQuad(Q))return Reject(Diagnostic,TEXT("Move7 actual float Canvas corners nonfinite or collapsed"));
+  Candidate.Parts.Add(MoveTemp(Part));
+ }
+ if(Candidate.Parts.Num()!=7)return Reject(Diagnostic,TEXT("Move7 incomplete fixed layer order"));
+ Candidate.Valid=true;Out=MoveTemp(Candidate);Diagnostic.Reset();return true;
 }
