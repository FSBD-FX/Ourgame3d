+bool SameProfile(const FProfile& A,const FProfile& B)
+{
+ if(A.ProfileId!=B.ProfileId||A.ProfileSHA256!=B.ProfileSHA256||A.SourceSnapshotSHA256!=B.SourceSnapshotSHA256
+  ||A.RegistrationEvidenceSHA256!=B.RegistrationEvidenceSHA256||A.TrialApprovalRecord!=B.TrialApprovalRecord
+  ||A.SourceClosureVerified!=B.SourceClosureVerified||A.TrialAllowed!=B.TrialAllowed||A.FinalAccepted!=B.FinalAccepted
+  ||A.CanvasSize!=B.CanvasSize||A.NearBranch!=B.NearBranch||A.FarBranch!=B.FarBranch
+  ||A.StandingExtent!=B.StandingExtent||A.TargetBodyHeight!=B.TargetBodyHeight||A.CycleWorld!=B.CycleWorld
+  ||A.HalfCycleWorld!=B.HalfCycleWorld||A.FootHalfStance!=B.FootHalfStance||A.SwingLift!=B.SwingLift
+  ||A.BodyBob!=B.BodyBob||A.SourceGround!=B.SourceGround||A.Sources.Num()!=B.Sources.Num()||A.LayerOrder!=B.LayerOrder)return false;
+ for(int32 I=0;I<A.Sources.Num();++I)
+ {
+  const auto& X=A.Sources[I];const auto& Y=B.Sources[I];
+  if(X.Component!=Y.Component||X.TexturePath!=Y.TexturePath||X.SourceSHA256!=Y.SourceSHA256
+   ||X.SourceRGBASHA256!=Y.SourceRGBASHA256||X.NativeBatchId!=Y.NativeBatchId
+   ||X.ComponentToRestScale!=Y.ComponentToRestScale||X.Markers.Num()!=Y.Markers.Num())return false;
+  for(int32 J=0;J<X.Markers.Num();++J)
+   if(X.Markers[J].Name!=Y.Markers[J].Name||X.Markers[J].Point!=Y.Markers[J].Point
+    ||X.Markers[J].SurfaceRGBA!=Y.Markers[J].SurfaceRGBA)return false;
+ }
+ return true;
+}
+FVector2D Rotate(FVector2D P,double A)
+{const double C=std::cos(A),S=std::sin(A);return {C*P.X-S*P.Y,S*P.X+C*P.Y};}
+double Angle(FVector2D P){return std::atan2(P.Y,P.X);}
+struct FCanonicalPart
+{FVector2D Pivot,Anchor;double Angle=0.;};
