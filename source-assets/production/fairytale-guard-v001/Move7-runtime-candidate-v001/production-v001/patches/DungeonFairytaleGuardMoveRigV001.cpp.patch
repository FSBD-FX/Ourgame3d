+// HUD::DrawTexture passes these floats into a positive-size Canvas tile. Its
+// four unrotated CPU vertex coordinates are also rounded to float. A positive
+// metadata size alone cannot prove that Left/Right or Top/Bottom are distinct.
+bool UsableCanvasQuad(const FSubmittedQuad& Q)
+{
+ const float Right=float(double(Q.X)+double(Q.Width)),Bottom=float(double(Q.Y)+double(Q.Height));
+ if(!std::isfinite(Q.X)||!std::isfinite(Q.Y)||!std::isfinite(Q.Width)||!std::isfinite(Q.Height)
+  ||!std::isfinite(Q.RotationDegrees)||!Finite(Q.RotationPivotUV)||Q.Width<=0.f||Q.Height<=0.f
+  ||!std::isfinite(Right)||!std::isfinite(Bottom)||Right<=Q.X||Bottom<=Q.Y)return false;
+ const FVector2D Anchor(double(Q.Width)*Q.RotationPivotUV.X,double(Q.Height)*Q.RotationPivotUV.Y);
+ for(FVector2D P:{FVector2D(Q.X,Q.Y),FVector2D(Right,Q.Y),FVector2D(Right,Bottom),FVector2D(Q.X,Bottom)})
+ {
+  const auto V=FVector2D(Q.X,Q.Y)+Anchor+Rotate(P-FVector2D(Q.X,Q.Y)-Anchor,double(Q.RotationDegrees)*MovePi/180.);
+  if(!Finite(V)||!std::isfinite(float(V.X))||!std::isfinite(float(V.Y)))return false;
+ }
+ return true;
+}
+bool ValidMoveSample(const FDungeonGuardMoveSample& S)
+{
+ namespace F=DungeonFairytaleGuardFullV003;const auto& N=S.NativeSelection;
+ if(!S.Valid||S.BlockKnown||!S.EntityId||S.EntityId!=S.AcceptedPathOwnerId||!S.RunGuid.IsValid()
+  ||!S.RoomInstanceId||!S.MovementEventId||S.EnemyContentId!=TEXT("ENM-STN-003")
+  ||(S.Facing!=1&&S.Facing!=-1)||!std::isfinite(S.SampleTime)||S.SampleTime<0.
+  ||S.MovementAtTime!=S.SampleTime||!std::isfinite(S.AcceptedDistance)||S.AcceptedDistance<=0.
+  ||!std::isfinite(S.CurrentAcceptedDistance)||S.CurrentAcceptedDistance<=0.||S.CurrentAcceptedDistance>S.AcceptedDistance
+  ||!Finite(S.GroundPosition)||!Finite(S.MovementFrom)||!Finite(S.MovementTo)||!Finite(S.MovementDirection)
+  ||!N.Valid||N.TerminalPresentation||N.DeathAfterglow||N.Clip!=F::EClip::Move||N.Phase!=DungeonStoneGuard::EPhase::Idle
+  ||N.EntityId!=S.EntityId||N.SourceEventId!=S.MovementEventId||N.Facing!=S.Facing||N.SampleTime!=S.SampleTime
+  ||N.AcceptedDistance!=S.AcceptedDistance||N.IntervalStart!=S.SampleTime||N.IntervalEnd!=S.SampleTime
+  ||N.Frame<0||N.Frame>=F::RequiredFrames(F::EClip::Move))return false;
+ const FVector2D Delta=S.MovementTo-S.MovementFrom;
+ const double Length=std::hypot(Delta.X,Delta.Y);
+ return Length==S.CurrentAcceptedDistance&&S.MovementDirection==Delta/Length
+  &&FVector(S.MovementTo.X,S.MovementTo.Y,0.).Equals(FVector(S.GroundPosition.X,S.GroundPosition.Y,0.))
+  &&N.DistancePhase==std::fmod(S.AcceptedDistance,128.)/128.;
+}
