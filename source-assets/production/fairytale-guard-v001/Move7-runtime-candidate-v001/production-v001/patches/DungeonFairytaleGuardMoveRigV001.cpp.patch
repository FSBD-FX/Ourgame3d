+bool PlanFromSample(const FDungeonGuardMoveSample& Sample,const FProfile& Source,const TArray<FResidentTexture>& Residents,
+ const FDrawContext& Context,FDrawPlan& Out,FString& Diagnostic)
+{
+ if(!ValidMoveSample(Sample))return Reject(Diagnostic,TEXT("Move7 requires the current completed positive Guard Move sample"));
+ if(!SameProfile(Source,Profile())||Residents.Num()!=7)return Reject(Diagnostic,TEXT("Move7 exact profile and seven resident owners required"));
+ for(const auto& S:Source.Sources)
+ {
+  const FResidentTexture* Found=nullptr;
+  for(const auto& R:Residents)if(R.Component==S.Component)
+  {if(Found)return Reject(Diagnostic,TEXT("Move7 duplicate resident component"));Found=&R;}
+  if(!Found||Found->TexturePath!=S.TexturePath||Found->ClassName!=TEXT("Texture2D")||Found->Width!=512||Found->Height!=512
+   ||!Found->ResourceReady||Found->PendingInitialization||Found->SourceSHA256!=S.SourceSHA256||Found->SourceRGBASHA256!=S.SourceRGBASHA256)
+   return Reject(Diagnostic,TEXT("Move7 complete Texture2D512 source provenance/residency gate failed"));
+ }
+ FSolveInput Input;Input.EntityId=Sample.EntityId;Input.AcceptedPathOwnerId=Sample.AcceptedPathOwnerId;
+ Input.AcceptedDistance=Sample.AcceptedDistance;Input.Facing=Sample.Facing;Input.Context=Context;
+ FDrawPlan Candidate;if(!Solve(Input,Source,Candidate.Rig,Diagnostic))return false;
+ const FLinearColor Tint=Sample.NativeSelection.MaterialHit?FLinearColor(1.45f,.85f,.62f,1.f):FLinearColor::White;
+ for(auto& Part:Candidate.Rig.Parts)Part.Quad.Tint=Tint;
+ Candidate.Sample=Sample;Candidate.Residents=Residents;Candidate.RequiredResources=7;Candidate.WholebodyIncludesAxe=true;
+ Candidate.IndependentAxeLayers=0;Candidate.TrialApprovalRecord=Source.TrialApprovalRecord;
+ Candidate.Valid=true;Out=MoveTemp(Candidate);Diagnostic.Reset();return true;
+}
