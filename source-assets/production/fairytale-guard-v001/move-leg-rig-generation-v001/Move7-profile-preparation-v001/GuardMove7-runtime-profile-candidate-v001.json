    "source_to_screen": "A=UIScale*diag(actualFacing,1)*(screenScale*kitScale*R(theta)); b=screenGround+UIScale*diag(actualFacing,1)*screenScale*anchor-A*sourcePivot; screen=A*sourcePixel+b.",
