# Historical checkpoints stay in the separate verified local archive.
/source-assets/production/backups/*
!/source-assets/production/backups/v148-SWDSecondary8-308-1495-203GREEN-v001/
/source-assets/production/backups/v148-SWDSecondary8-308-1495-203GREEN-v001/*
